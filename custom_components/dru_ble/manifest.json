{
  "domain": "dru_ble",
  "name": "DRU Fireplace Bluetooth",
  "bluetooth": [
    {
      "connectable": true,
      "local_name": "DFGT*"
    }
  ],
  "codeowners": ["@lackas"],
  "config_flow": true,
  "dependencies": ["bluetooth_adapters"],
  "documentation": "https://github.com/lackas/ha-dru-ble",
